# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models — exact strings from each model's "API" / OpenAI snippet on https://build.nvidia.com
# (e.g. meta/llama-3.1-8b-instruct). Do NOT paste a Build "function" UUID as model=.
#
# If you see 404 "Function '<uuid>' not found", your LARGE_MODEL slug maps to a deployment
# you are not entitled to — pick another model on Build and copy its id here.
LARGE_MODEL=meta/llama-3.1-70b-instruct
SMALL_MODEL=meta/llama-3.1-8b-instruct

# USD per 1M tokens (set from your NVIDIA pricing)
LARGE_INPUT_PRICE_PER_M=2.0
LARGE_OUTPUT_PRICE_PER_M=2.0
SMALL_INPUT_PRICE_PER_M=0.15
SMALL_OUTPUT_PRICE_PER_M=0.15

# Agent limits
MAX_ORCHESTRATOR_STEPS=40
READ_FILE_MAX_LINES_DUAL=400
SMALL_MODEL_MAX_TOKENS_DEFAULT=400
